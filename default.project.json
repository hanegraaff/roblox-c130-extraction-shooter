{
  "name": "PlayersVsC130",
  "globIgnorePaths": ["**/*.md", "**/*.spec.luau", "**/*.test.luau"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {"$path": "src/shared"}
    },
    "ServerScriptService": {
      "Server": {"$path": "src/server"}
    },
    "ServerStorage": {
      "Assets": {"$path": "assets/models"}
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {"$path": "src/client"}
      }
    },
    "Workspace": {
      "$properties": {"StreamingEnabled": false},
      "World": {"$path": "assets/world"}
    }
  }
}
