{
  "name": "PlayersVsC130",
  "globIgnorePaths": ["**/*.md", "**/*.spec.luau", "**/*.test.luau"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {"$path": "src/shared", "VesperThermalSurfaces": {"$path": "assets/presentation/VesperThermalSurfaces.model.json"}, "SaltFlatsThermalSurfaces": {"$path": "assets/presentation/SaltFlatsThermalSurfaces.model.json"}}
    },
    "ServerScriptService": {
      "Server": {"$path": "src/server"}
    },
    "ServerStorage": {
      "Assets": {"$path": "assets/models"}
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {"$path": "src/client"}
      }
    },
    "Lighting": {"$className": "Lighting", "$properties": {"GlobalShadows": true, "Brightness": 2.1, "ClockTime": 15.4, "Ambient": [0.322, 0.314, 0.298], "OutdoorAmbient": [0.569, 0.573, 0.58], "EnvironmentDiffuseScale": 0.5, "EnvironmentSpecularScale": 0.35}},
    "Workspace": {
      "$properties": {"StreamingEnabled": false},
      "World": {"$className": "Folder", "Battlefield": {
        "$path": "assets/world/Battlefield.model.json",
        "DistrictScenery": {"$path": "assets/imports/districts/DistrictScenery.rbxm"},
        "MarsBoulders": {"$path": "assets/imports/districts/MarsBoulders.rbxm"},
        "LobbyStation": {
          "$className": "Folder",
          "LobbyCollision": {"$path": "assets/imports/lobby-interior/LobbyCollision.model.json"},
          "LobbyArt": {"$path": "assets/imports/lobby-interior/LobbyArt.rbxm"}
        }
      }}
    }
  }
}
