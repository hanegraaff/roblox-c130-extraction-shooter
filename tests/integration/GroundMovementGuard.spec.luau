--!strict
-- P06 A3: server-observed movement budget and explicit correction boundaries.
type API = typeof(require(game:GetService("ServerScriptService").Server.GroundMovementGuard))
return function(test: (string, () -> ()) -> (), candidate: unknown)
    local rules = candidate :: API
    test("ordinary motion and delayed replication fit bounded movement credit", function()
        local owner = rules.new()
        assert(owner.reset(0, 3, 0, 0), "trusted spawn rejected")
        assert(owner.sample(8, 3, 0, 0.5), "ordinary running rejected")
        assert(owner.sample(20, 10, 0, 1), "jump or short latency rejected")
        assert(owner.sample(30, 3, 0, 1.5), "ordinary recovery rejected")
    end)
    test("teleport remains quarantined until return or explicit server correction", function()
        local owner = rules.new()
        assert(owner.reset(0, 3, 0, 0), "trusted spawn rejected")
        assert(not owner.sample(0, 103, 0, 0.1), "implausible movement accepted")
        assert(not owner.sample(0, 103, 0, 20), "idle time laundered a teleport")
        assert(owner.sample(0, 5, 0, 20.1), "return to trusted point rejected")
        assert(not owner.sample(300, 3, 0, 20.2), "second teleport accepted")
        assert(owner.reset(120, 3, 0, 20.3), "trusted map correction rejected")
        assert(owner.sample(121, 3, 0, 20.4), "movement after correction rejected")
    end)
    test("invalid and reversed clock samples reject without corrupting valid state", function()
        local owner = rules.new()
        assert(not owner.sample(0, 0, 0, 0), "uninitialized sample accepted")
        assert(not owner.reset(math.huge, 0, 0, 0), "invalid spawn accepted")
        assert(owner.reset(0, 0, 0, 5), "trusted spawn rejected")
        assert(not owner.sample(0 / 0, 0, 0, 6), "NaN accepted")
        assert(not owner.sample(0, 0, 0, 4), "reversed time accepted")
        assert(owner.sample(1, 0, 0, 5.1), "valid recovery rejected")
    end)
end
