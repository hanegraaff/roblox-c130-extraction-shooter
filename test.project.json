{
  "name": "PlayersVsC130Tests",
  "globIgnorePaths": [
    "**/*.md"
  ],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared",
        "VesperThermalSurfaces": {
          "$path": "assets/presentation/VesperThermalSurfaces.model.json"
        },
        "SaltFlatsThermalSurfaces": {
          "$path": "assets/presentation/SaltFlatsThermalSurfaces.model.json"
        }
      },
      "TestPackages": {
        "$path": "Packages"
      },
      "ClientSpecs": {
        "$path": "tests/studio/specs-client"
      },
      "P11Metrics": {
        "$path": "tests/studio/support/P11Metrics.luau"
      },
      "HarnessCompatibility": {
        "$path": "tests/studio/support/HarnessCompatibility.luau"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "ServerTests": {
        "$path": "tests/studio/server"
      }
    },
    "ServerStorage": {
      "Assets": {
        "$path": "assets/models"
      },
      "Tests": {
        "$className": "Folder",
        "Unit": {
          "$path": "tests/unit"
        },
        "Integration": {
          "$path": "tests/integration"
        },
        "Studio": {
          "$path": "tests/studio/specs-server"
        },
        "Fixtures": {
          "$path": "tests/fixtures"
        }
      },
      "DevelopmentSettings": {
        "$path": "tests/fixtures/DevelopmentSettings.luau"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        },
        "ClientTests": {
          "$path": "tests/studio/client"
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "GlobalShadows": true,
        "Brightness": 2.1,
        "ClockTime": 15.4,
        "Ambient": [
          0.322,
          0.314,
          0.298
        ],
        "OutdoorAmbient": [
          0.569,
          0.573,
          0.58
        ],
        "EnvironmentDiffuseScale": 0.5,
        "EnvironmentSpecularScale": 0.35
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      },
      "World": {
        "$className": "Folder",
        "Battlefield": {
          "$path": "assets/world/Battlefield.model.json",
          "DistrictScenery": {
            "$path": "assets/imports/districts/DistrictScenery.rbxm"
          },
          "MarsBoulders": {
            "$path": "assets/imports/districts/MarsBoulders.rbxm"
          }
        }
      }
    }
  }
}
